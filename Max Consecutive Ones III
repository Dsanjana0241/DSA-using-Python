#Max Consecutive Ones III(Leetcode-1004)

#Brute Force Solution

class Solution:
    def longestOnes(self, nums: List[int], k: int) -> int:
         n=len(nums)
         maxi=0
         for i in range(0,n):
             zeros=0
             for j in range(i,n):
                  if nums[j]==0:
                         zeros+=1
                  if zeros>k:
                         break
                  maxi=max(maxi,j-i+1)
          return maxi

#Time complexity=O(N(N+1)/2)~=O(N**2)
#Space complexity=O(1)

#Better solution

class Solution:
    def longestOnes(self, nums: List[int], k: int) -> int:
           l=0
           r=0
           maxi=0
           zeros=0
           n=len(nums)
           while r<n:
                 if nums[r]==0:
                      zeros+=1
                 while zeros>k:
                       if nums[l]==0:
                              zeros-=1
                       l+=1
                if zeros<=k:
                        maxi=max(maxi,r-l+1)
                r+=1
                
          return maxi


#Time complexity=O(N(N+1)/2)~=O(N**2)
#Space complexity=O(1)


#Optimal solution

class Solution:
    def longestOnes(self, nums: List[int], k: int) -> int:
                n=len(nums)
                maxi=0
                r=0
                l=0
                z=0
                while r<n:
                      if nums[r]==0:
                          z+=1
                      if z>k:
                             if nums[l]==0:
                               z-=1
                             l+=1
                      if z<=k:
                            maxi=max(maxi,r-l+1)
                      r+=1
                 return maxi

#Time complexity=O(N)
#Space complexity=O(1)


