#. Minimum Bit Flips to Convert Number(Leetcode-2220)

class Solution:
    def minBitFlips(self, start: int, goal: int) -> int:
       ans=start^goal
       count=0
       for i in range(0,32):
             if ans&(i<<i)!=0:
                 count+=1
       return count

#Time Complexity=O(32)
#Space Complexity=O(1)
