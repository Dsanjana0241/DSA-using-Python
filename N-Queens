#N-Queens(Leetcode-51)

#Optimal solution

from typing import List

class Solution:
    def solve(self, col, board, ans, leftrow, upper, lower, n):
        if col == n:
            ans.append(board[:])
            return

        for row in range(n):

            if leftrow[row] == 0 and upper[row + col] == 0 and lower[n - 1 + col - row] == 0:

                board[row] = board[row][:col] + "Q" + board[row][col + 1:]

                leftrow[row] = 1
                upper[row + col] = 1
                lower[n - 1 + col - row] = 1

                self.solve(col + 1, board, ans, leftrow, upper, lower, n)

                board[row] = board[row][:col] + "." + board[row][col + 1:]

                leftrow[row] = 0
                upper[row + col] = 0
                lower[n - 1 + col - row] = 0

    def solveNQueens(self, n: int) -> List[List[str]]:

        ans = []

        board = ["." * n for _ in range(n)]

        leftrow = [0] * n
        upper = [0] * (2 * n - 1)
        lower = [0] * (2 * n - 1)

        self.solve(0, board, ans, leftrow, upper, lower, n)

        return ans

#Time complexity=O(N)
#Space complexity=O(N)+O(N)+O(N**2)
