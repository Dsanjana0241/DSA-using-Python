#Subsequence with Sum K

class Solution:
    def checkSubsequenceSum(self, arr, k):
        def backtrack(index, total, subset):
            if total == k:
                return True
            elif total > k:
                return False

            if index >= len(arr):
                return False

            subset.append(arr[index])
            sum = total + arr[index]

            pick = backtrack(index + 1, sum, subset)
            if pick:
                return True

            subset.pop()

            sum = total
            not_pick = backtrack(index + 1, sum, subset)
            return not_pick

        return backtrack(0, 0, [])

#Time Complexity=O(2**N)
#Space compexity=O(N)
