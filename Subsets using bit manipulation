#Subsets using bit manipulation(Leetcode-78)

#Optimal Solution
class Solution:
    def subsets(self, nums: List[int]) -> List[List[int]]:
        res=[]
        n=len(nums)
        total_subsets=2**n
        for num in range(0,total_subsets):
            lst=[]
            for i in range(0,n):
                if num & (1<<i)!=0:
                    lst.append(nums[i])
            res.append(lst)
        return res
        
