#Diameter of Binary Tree(Leetcode-543)

class Solution:
    d=0
    def solve(self,root):
          if root is None:
                  return 0
          lh=self.solve(root.left)
          rh=self.solve(root.right)
          self.d=max(self.d,lh+rh)
          return 1+max(lh,rh)
   def diameterOfBinaryTree(self, root: Optional[TreeNode]) -> int:
         self.d=0
         self.solve(root)
         return self.d

#Time Complexity=O(N)
#Space Complexity=O(H)
