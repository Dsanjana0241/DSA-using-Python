#Bottom View of Binary Tree

'''
Definition for Node
class Node:
    def __init__(self, val):
        self.data = val
        self.right = None
        self.left = None
'''

class Solution:
    def bottomView(self, root):
           if not root:
                return None
           queue=deque()
           ans=[]
           res={}
           queue.append((root,0))
           while queue:
               e,line=queue.popleft()
               res[line]=e.data
               if e.left:
                    queue.append((e.left,line-1))
               if e.right:
                      queue.append((e.right,line+1))
          for value in sorted(res.items()):
                 ans.append(value[1])
          return ans

#Time Complexity=O(2N)+O(N log N)
#Space Complexity=O(N)
