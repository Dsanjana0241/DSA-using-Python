#Fruit Into Baskets(Leetcode-904)

#Brute Force solution
class Solution:
    def totalFruit(self, nums: List[int]) -> int:
           max_length=0
           n=len(nums)
           for i in range(i,n):
              my_set=set()
              for j in range(i,n):
                    my_set.add(nums[j])
                    if len(my_set)>2:
                          break
              max_length=max(max_length,j-i+1)
          return max_length

#Time Complexity=O(N*(N+1)/2)
#Space complexity=O(1)

