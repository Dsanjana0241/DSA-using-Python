#Activity Selection(GFG) -greedy Technique

#Solution
class Meeting:
      def __init__(self,start,end,pos):
              self.start=start
              self.end=end
              self.pos=pos
class Solution:
         def activitySelection(self, start, end):
               meet=[Meeting(start[i],end[i],i+1) for i in range(len(start))]
               meet.sort(key=lambda x:(x.end,x.start))
               n=len(start)
               c=1
               last=meet[0].end
               for i in range(1,n):
                    if meet[i].end>last:
                         c+=1
                         last=meet[i].end
               return c

#Time Complexity=O( N log N)
#Space Complexity=O(N)

