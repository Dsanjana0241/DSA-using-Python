#Generate Parentheses(Leetcode-22)

class Solution:
    def generateParenthesis(self, n: int) -> List[str]:
        def solve(ind,total,brackets,res):
            if ind>=len(brackets):
                    if total==0:
                        res.append("".join(brackets))
                    return
            if total>len(brackets)//2:
                  return
            if total<0:
               return
            brackets[ind]='('
            sum=total+1
            solve(ind+1,sum,brackets,res)
            brackets[ind]=')'
            sum=total-1
            solve(ind+1,sum,bracktes,res)
            return res
       brackets=[""]*(n*2)
       return solve(0,0,bracktes,[])

#Time Complexity=O(2**N)
#Space complexity=O(2N)~=O(N)
