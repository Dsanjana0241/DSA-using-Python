# Implement Queue using Stacks(Leetcode-232)

#Solution
class MyQueue:

    def __init__(self):
        self.st1=[]
        self.st2=[]
        

    def push(self, x: int) -> None:#O(2N)
        while  self.st1:
            self.st2.append(self.st1.pop())
        self.st1.append(x)
        while  self.st2:
            self.st1.append(self.st2.pop())
        

    def pop(self) -> int:#O(1)
        if not self.st1:
            return []
        x=self.st1.pop()
        return x
        

    def peek(self) -> int:O(1)
      
        if not self.st1:
            return []
        return self.st1[-1]
        

    def empty(self) -> bool:#O(1)
        return len(self.st1)==0
        


