#Prefix to Postfix Conversion

class Solution:
    def preToPost(self, s):
        # Code here
        stack=[]
        n=len(s)
        for i in range(n-1,-1,-1):
            ch=s[i]
            if ch.isalnum():
                stack.append(ch)
            else:
                o1=stack.pop()
                o2=stack.pop()
                new=o1+o2+ch
                stack.append(new)
        return stack[-1]

#Time complexity=O(N)
#Space complexity=O(N)
