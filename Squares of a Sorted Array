#Squares of a Sorted Array(Leetcode-977)

class Solution:
    def sortedSquares(self, nums: List[int]) -> List[int]:
        res=[]
        for i in range(len(nums)):
            res.append(nums[i]**2)
        res.sort()
        return res

#Time Complexity=O(N)+O(N log N)
#Space Complexity=O(N)
        
